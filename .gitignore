# 密钥 / 本地配置
.env
config.yaml
# web 设置页写入的运行时覆盖配置（含密钥）
overrides.yaml

# Node
node_modules/
dist/
*.tsbuildinfo

# 运行时数据（SQLite 主库 + WAL 模式伴随文件）
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
logs/
run/

# Chrome DevTools managed 模式的专用浏览器 profile（含运行期 cookie，绝不入库）
.chrome-profile/

# IDE / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地服务输出可能包含连接地址、工作区路径和用户信息
/service*.log

# 本地调试设置与临时查询脚本
/.claude/settings.local.json
/tapd_query_tmp.mjs
