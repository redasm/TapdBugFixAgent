# Tapd 后端：mcp（推荐，个人访问令牌）或 rest（API 账号）
TAPD_BACKEND=mcp
# 个人访问令牌（个人设置-个人访问令牌 创建），本地 stdio 模式只需这个
TAPD_ACCESS_TOKEN=
# 仅当使用腾讯云托管 streamable-http 时才需要：
# MCP_URL=
# MCP_TOKEN=

# backend=rest 时：Tapd OpenAPI 凭据（个人设置 -> API账号 创建）
TAPD_API_USER=
TAPD_API_PASSWORD=

# Perforce（覆盖 config.yaml 中 p4 段）
P4PORT=ssl:perforce.example.com:1666
P4CLIENT=tapd-agent_yourname
P4USER=your_p4_user
P4PASSWD=
P4IGNORE=.p4ignore

# Web 管理台鉴权 token
WEB_TOKEN=

# 可选：config.yaml 未填写 pi.provider.api_key 时使用此变量
# PI_API_KEY=
