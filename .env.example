# Tapd 后端：mcp（推荐，个人访问令牌）或 rest（API 账号）
TAPD_BACKEND=mcp
# 个人访问令牌（个人设置-个人访问令牌 创建），本地 stdio 模式只需这个
TAPD_ACCESS_TOKEN=
# 仅当使用腾讯云托管 streamable-http 时才需要：
# MCP_URL=
# MCP_TOKEN=

# backend=rest 时：Tapd OpenAPI 凭据（个人设置 -> API账号 创建）
TAPD_API_USER=
TAPD_API_PASSWORD=

# Perforce（覆盖 config.yaml 中 p4 段）
P4PORT=ssl:perforce.example.com:1666
P4CLIENT=tapd-agent_yourname
P4USER=your_p4_user
P4PASSWD=

# Web 管理台鉴权 token
WEB_TOKEN=

# OpenAI Codex SDK（agent.backend=codex 时使用；也可沿用本机 Codex 登录状态）
OPENAI_API_KEY=

# pi 编码 Agent 鉴权（pi 0.74.2 不读 ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN 作为 base_url 覆盖）：
# 本司 Claude Code 网关已配好（~/.pi/agent/models.json 的 kuro provider，apiKey 引用 ANTHROPIC_AUTH_TOKEN
# 环境变量名，运行期解析，密钥不落盘），走该网关时无需再配任何 key。
# 其他路径：填 ANTHROPIC_API_KEY（或 ANTHROPIC_OAUTH_TOKEN），或先跑一次 `pi /login`。
# 模型覆盖用 config.yaml 里 pi.model（对应 --model provider/id），不走环境变量。
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=
